# Copy to .env and fill in. Nothing here has a working default on purpose —
# the app refuses to start without a signing key rather than falling back to
# a built-in one.

# Postgres connection. JDBC form — note this is NOT the postgres://... URL
# that Neon, Fly and most providers hand you. Convert it:
#   postgres://user:pass@host/dbname?sslmode=require
#   -> jdbc:postgresql://host/dbname?sslmode=require   (user/pass separate)
# Neon requires sslmode=require; the connection is refused without it.
DATABASE_URL=jdbc:postgresql://localhost:5432/worktrack
DATABASE_USERNAME=worktrack
DATABASE_PASSWORD=change-me

# HMAC signing key for the JWTs. At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=720

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ekql-ops.github.io

# Seed the sample staff and a week of shifts on first start.
DEMO_SEED=false
DEMO_PASSWORD=
